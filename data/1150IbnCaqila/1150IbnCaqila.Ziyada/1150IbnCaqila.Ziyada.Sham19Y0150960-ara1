# في (هود): {وأمطرنا عليها} [82]، وفي (الحجر): {عليهم} [74].
# [في الحجر] {وما يأتيهم من رسول} [11]، وفي (الزخرف): {من نبي} [7].
# في (الحجر): {كذلك نسلكه} [12]، وفي (الشعراء): {سلكنه} [200].
# في (الكهف): {ولئن رددت} [36]، وفي (حم): {ولن رجعت} [فصلت: 50].
# في (الكهف): {فأعرض عنها} [57]، وفي (ألم السجدة): {ثم أعرض عنها} [22].
# في ms0911 (طه): {وسلك لكم فيها سبلا} [53]، وفي (الزخرف): {وجعل} [10].
# في (الأنبياء): {وأرادوا به كيدا فجعلنهم الأخسرين}، وفي (الصافات):
~~{فأرادوا به كيدا فجعلنهم الأسفلين}.

PageV06P339

# في (الأنبياء): {وتقطعوا أمرهم بينهم} [93]، وفي (المؤمنين): {فتقطعوا} [53].
# في (النمل): {ففزع من في السموات} [87].
# وفي (الزمر): {فصعق} [68]. في (القصص): {وما أوتيتم} [9] وفي (حم) (عسق):
~~{فما أوتيتم} [الشورى].
# في (العنكبوت): {لتشرك بي}، وفي (لقمان): {على أن تشرك بي} [15].
# في (حم السجدة): {ثم كفرتم به} [فصلت: 53]، وفي (الأحقاب): {وكفرت به} [10].

